# Manual API tests. Open this file in VS Code with the "REST Client" extension
# and click "Send Request" above each request. Cookies are kept between requests.
# Change the port to the https port shown when you run the API.
# reception1 and its passwords below are fictitious demo values for local testing only.
@baseUrl = https://localhost:7019

### 1. Not logged in yet: expect 401 Unauthorized
GET {{baseUrl}}/api/auth/me

### 2. Wrong password: expect 401 "Invalid username or password."
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "userName": "admin", "password": "wrong" }

### 3. Log in as admin: expect 200 with roles ["Administrator"]
# VS Code asks for the password when you click Send, so it is never saved in this file.
# @prompt adminPassword
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "userName": "admin", "password": "{{adminPassword}}" }

### 4. Who am I? expect 200
GET {{baseUrl}}/api/auth/me

### 5. Create a receptionist (fictitious test user): expect 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "userName": "reception1",
  "email": "reception1@example.test",
  "password": "Recept#2027",
  "roles": ["Receptionist"]
}

### 6. List users: expect 200
GET {{baseUrl}}/api/users

### 7. Log out: expect 204
POST {{baseUrl}}/api/auth/logout

### 8. Log in as the receptionist: expect 200 with roles ["Receptionist"]
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "userName": "reception1", "password": "Recept#2027" }

### 9. Receptionist tries to list users: expect 403 Forbidden
GET {{baseUrl}}/api/users

### 10. Change own password: expect 204
POST {{baseUrl}}/api/auth/change-password
Content-Type: application/json

{ "currentPassword": "Recept#2027", "newPassword": "Recept#2028" }

### 11. Log out: expect 204, then request 4 returns 401 again
POST {{baseUrl}}/api/auth/logout
