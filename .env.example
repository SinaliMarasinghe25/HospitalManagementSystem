# Copy this file to .env and choose your own passwords:
#   Copy-Item .env.example .env
# .env is listed in .gitignore, so it never goes to GitHub.

# Password for the database user hms_app. Use only letters and digits (no ; or quotes), 20 or more.
DB_PASSWORD=ChangeMeToALongRandomPassword123

# Password for the first "admin" login. At least 8 characters with upper case, lower case, a digit and a symbol.
ADMIN_PASSWORD=Change#Me2026

# Demo data (step 33). true = add made-up patients, staff, visits and bills ONCE, for a demonstration.
# DEMO_PASSWORD is the password of every demo login (same rules as ADMIN_PASSWORD).
DEMO_DATA=false
DEMO_PASSWORD=Demo#Pass2026
